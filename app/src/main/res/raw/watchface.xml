        <Condition>
            <Expressions>
                <Expression name="batteryCharging"><![CDATA[[BATTERY_CHARGING_STATUS]]]></Expression>
                <Expression name="batteryEmpty"><![CDATA[[BATTERY_PERCENT] <= 5]]></Expression>
                <Expression name="batteryCritical"><![CDATA[[BATTERY_PERCENT] > 5 && [BATTERY_PERCENT] <= 20]]></Expression>
                <Expression name="batteryLow"><![CDATA[[BATTERY_PERCENT] > 20 && [BATTERY_PERCENT] <= 40]]></Expression>
                <Expression name="batteryMedium"><![CDATA[[BATTERY_PERCENT] > 40 && [BATTERY_PERCENT] <= 60]]></Expression>
                <Expression name="batteryGood"><![CDATA[[BATTERY_PERCENT] > 60 && [BATTERY_PERCENT] <= 80]]></Expression>
            </Expressions>
            <Compare expression="batteryCharging">
                <PartText x="145" y="185" width="250" height="34">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="START">
                        <Font family="monospace" size="20" weight="MEDIUM" color="#00E676">
                            <Template><![CDATA[[CHG] %d%%]]>
                                <Parameter expression="[BATTERY_PERCENT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Compare>
            <Compare expression="batteryEmpty">
                <PartText x="145" y="185" width="250" height="34">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="START">
                        <Font family="monospace" size="20" weight="MEDIUM" color="#FF5252">
                            <Template><![CDATA[[.....] %d%%]]>
                                <Parameter expression="[BATTERY_PERCENT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Compare>
            <Compare expression="batteryCritical">
                <PartText x="145" y="185" width="250" height="34">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="START">
                        <Font family="monospace" size="20" weight="MEDIUM" color="#FF5252">
                            <Template><![CDATA[[#....] %d%%]]>
                                <Parameter expression="[BATTERY_PERCENT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Compare>
            <Compare expression="batteryLow">
                <PartText x="145" y="185" width="250" height="34">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="START">
                        <Font family="monospace" size="20" weight="MEDIUM" color="#FF9800">
                            <Template><![CDATA[[##...] %d%%]]>
                                <Parameter expression="[BATTERY_PERCENT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Compare>
            <Compare expression="batteryMedium">
                <PartText x="145" y="185" width="250" height="34">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="START">
                        <Font family="monospace" size="20" weight="MEDIUM" color="[CONFIGURATION.theme.2]">
                            <Template><![CDATA[[###..] %d%%]]>
                                <Parameter expression="[BATTERY_PERCENT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Compare>
            <Compare expression="batteryGood">
                <PartText x="145" y="185" width="250" height="34">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="START">
                        <Font family="monospace" size="20" weight="MEDIUM" color="[CONFIGURATION.theme.3]">
                            <Template><![CDATA[[####.] %d%%]]>
                                <Parameter expression="[BATTERY_PERCENT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Compare>
            <Default>
                <PartText x="145" y="185" width="250" height="34">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="START">
                        <Font family="monospace" size="20" weight="MEDIUM" color="[CONFIGURATION.theme.3]">
                            <Template><![CDATA[[#####] %d%%]]>
                                <Parameter expression="[BATTERY_PERCENT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Default>
        </Condition>

